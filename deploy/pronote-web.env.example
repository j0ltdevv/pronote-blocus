# Environnement du service pronote-web (API + PWA).
# Copier vers /etc/pronote-blocus/pronote-web.env puis :
#   chown root:pronote-blocus /etc/pronote-blocus/pronote-web.env
#   chmod 0640 /etc/pronote-blocus/pronote-web.env
# Format systemd : une variable par ligne, pas de `export`, pas de guillemets
# obligatoires, pas de commentaire en fin de ligne.
#
# TELEGRAM_BOT_TOKEN n'est PAS nécessaire ici : le serveur web démarre avec
# `require_token=False` et n'utilise pas le bot Telegram.

# --- Obligatoires -----------------------------------------------------------
# La MÊME clé Fernet que le bot (pronote-blocus.env) : elle chiffre les jetons
# PRONOTE stockés dans la base partagée. Une clé différente = « jeton
# illisible » pour tous les élèves. À SAUVEGARDER hors du dépôt.
APP_SECRET=

# Domaine public, tel qu'il apparaît dans la barre d'adresse, sans slash final.
# Doit correspondre au CORS `allow_origins` du serveur (voir README) : un
# domaine absent de cette liste voit ses requêtes bloquées par le navigateur.
WEB_ORIGIN=https://pronote.example.org

# --- Facultatives -----------------------------------------------------------
# Endpoint OpenAI-compatible pour les questions libres (facultatif : sans lui,
# l'interface renvoie la liste filtrée, sans consommation de quota).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 0 = le corps des messages de professeurs ne quitte jamais le serveur.
LLM_MESSAGES=1

# Plafond de connexions PRONOTE simultanées.
MAX_CONCURRENT_SYNCS=4

# Heure locale (0-23) à partir de laquelle le résumé quotidien part.
DIGEST_HOUR=18

# Nombre de sauvegardes conservées dans DATA_DIR/backups/ (défaut 5).
BACKUP_KEEP=5

# Doit correspondre au ReadWritePaths= du service.
DATA_DIR=/var/lib/pronote-blocus

# Début de la fenêtre de rattrapage (AAAA-MM-JJ).
WINDOW_START=2026-10-01

# URL PRONOTE utilisée si le QR ne porte pas d'URL exploitable.
DEFAULT_PRONOTE_URL=https://ETABLISSEMENT.index-education.net/pronote/eleve.html

# Paramètres de l'endpoint mobile PRONOTE.
PRONOTE_MOBILE_QUERY=?fd=1&bydlg=A6ABB224-12DD-4E31-AD3E-8A39A1C2C335&login=true
