[Unit]
Description=Pronote Blocus — API web et PWA (uvicorn)
Documentation=https://github.com/pronote-blocus/pronote-blocus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pronote-blocus
Group=pronote-blocus
WorkingDirectory=/opt/pronote-blocus
EnvironmentFile=/etc/pronote-blocus/pronote-web.env

# DATA_DIR de l'environnement doit pointer ici (voir pronote-web.env.example).
# Le venv contient le paquet installé en editable : `pip install -e .`.
# L'interface web n'écoute QUE sur la boucle locale : le TLS et l'accès public
# passent par le reverse proxy (voir Caddyfile). Ne jamais passer --host 0.0.0.0.
ExecStart=/opt/pronote-blocus/.venv/bin/python -m uvicorn server.main:app --host 127.0.0.1 --port 8000

Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
KillSignal=SIGTERM

# Journal : journalctl -u pronote-web -f
StandardOutput=journal
StandardError=journal

# Durcissement (identique à pronote-blocus.service)
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

# Seul DATA_DIR (app.db, uploads/, locks/) est inscriptible.
ReadWritePaths=/var/lib/pronote-blocus

[Install]
WantedBy=multi-user.target
